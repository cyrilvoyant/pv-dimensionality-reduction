      "name": "Lionel Menard",
      "@id": "https://orcid.org/0009-0002-2156-8538"
    },
    {
      "@type": "Person",
      "name": "Cyril Voyant",
      "@id": "https://orcid.org/0000-0003-0242-7377"
    }
  ],
  "wsem:declaresParameter": [
    {
      "@type": "PropertyValueSpecification",
      "name": "data",
      "description": "PV power series of the study (data/ folder)",
      "valueRequired": true,
      "unitText": "kW",
      "unitCode": "http://qudt.org/vocab/unit/KiloW"
    }
  ],
  "wsem:declaresOutput": [
    {
      "@type": "PropertyValueSpecification",
      "name": "tables",
      "description": "errors by method and dimension, parameter reduction against the full-input ELM, baselines",
      "valueRequired": true
    }
  ]
}
