{
  "@context": {
    "@vocab": "https://schema.org/",
    "wsem": "https://w3id.org/websemantic/ns#"
  },
  "@type": "SoftwareSourceCode",
  "@id": "https://doi.org/10.5281/zenodo.21755938",
  "name": "Filter and wrapper diagnostics of dimensionality reduction for endogenous PV power forecasting (MATLAB)",
  "description": "Compresses the lagged history of a PV plant before an ELM reads it, and judges each reduction twice: does the reduced space keep the geometry (filter), and does it help the forecast (wrapper)?",
  "codeRepository": "https://github.com/cyrilvoyant/pv-dimensionality-reduction",
  "license": "MIT",
  "programmingLanguage": "MATLAB",
  "keywords": [
    "dimensionality reduction",
    "PV forecasting",
    "extreme learning machine",
    "manifold learning"
  ],
  "dateModified": "2026-10-23",
  "author": [
    {
      "@type": "Person",
      "name": "Hassen Bouzgou"
    },
    {
      "@type": "Person",
      "name": "Gabriel Chesnoiu"
    },
