:software a wsem:Software, schema:SoftwareSourceCode ;
    schema:name "Filter and wrapper diagnostics of dimensionality reduction for endogenous PV power forecasting (MATLAB)" ;
    schema:codeRepository <https://github.com/cyrilvoyant/pv-dimensionality-reduction> ;
    wsem:conceptDOI "https://doi.org/10.5281/zenodo.21755938" ;
    schema:identifier <https://doi.org/10.5281/zenodo.21755938> ;
    schema:license "MIT" ;
    schema:programmingLanguage "MATLAB" ;
    schema:description "Compresses the lagged history of a PV plant before an ELM reads it, and judges each reduction twice: does the reduced space keep the geometry (filter), and does it help the forecast (wrapper)?" ;
